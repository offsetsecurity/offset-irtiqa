# Copy this to .env beside compose.yaml, then fill in the two secrets.
#
#   cp env.example .env
#
# Generate each secret with:
#
#   docker run --rm node:24-alpine node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# or, if you have Node to hand:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Keep this file. Without the same SESSION_SECRET everyone is signed out on the
# next start, and without the same FIELD_ENC_KEY any stored secret — today the
# mail password — cannot be read back. Both are needed if you ever move the
# data volume to another machine.
#
# .env is in .gitignore and .dockerignore. Leave it that way.

# This build carries one framework pack and PRODUCT is already set to it.
# Do not change it: the database belongs to this product.
PRODUCT=ascend

# Which images to run: the published ones, newest first.
#
# Name a version instead - :0.2.2 - to hold this machine on one. Building from
# a copy of the source? Comment both lines out and compose builds them here.
#
# The updater writes these lines when an update is installed, so they always
# say what is actually running.
OFFSET_IMAGE=ghcr.io/offsetsecurity/offset-ascend:latest
OFFSET_UPDATER_IMAGE=ghcr.io/offsetsecurity/offset-ascend-updater:latest
APP_VERSION=0.1.0

# Lets an administrator install updates from Settings.
#
# It starts a second, small container - the updater - because a container
# cannot replace itself: the application would be swapping the image it is
# running inside. The updater pulls the new image, swaps it in, restarts, and
# puts the old one back if the new one does not come up healthy.
#
# Delete this line if your policy does not allow a container access to the
# Docker socket. Everything else still works; updates are then a pull and a
# restart by hand.
COMPOSE_PROFILES=updates

# The port on your machine. The container always listens on 8080 inside.
#
# Check it is free before you start: on Windows,
#   Get-NetTCPConnection -LocalPort 8080 -State Listen
# on Linux,
#   ss -ltn 'sport = :8080'
# Nothing printed means nothing is using it. A port already taken makes the
# container start, fail to listen and stop, which reads like a fault and is not.
#
# Two products on one machine need two different values here.
#
# compose publishes it to 127.0.0.1 only, so nothing outside this machine
# can reach it. That is deliberate: the product terminates no TLS of its
# own. Put a reverse proxy with a certificate in front before removing the
# 127.0.0.1 prefix in compose.yaml.
HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080

# 32 bytes of hex each, 64 characters. The API refuses to start without them.
SESSION_SECRET=
FIELD_ENC_KEY=

SESSION_TTL_HOURS=12

# ── background work ──────────────────────────────────────────────────────────
# Local hour, 24-hour clock, for the nightly jobs. The container's clock is
# UTC unless you set TZ below.
DAILY_JOB_HOUR=2
BACKUP_ENABLED=true
BACKUP_KEEP=3
# TZ=Asia/Kolkata

# 0 keeps the audit log for ever, which is the safe default: an audit trail is
# evidence, and deleting it should be a deliberate act.
AUDIT_RETENTION_DAYS=0

# Only for a reverse proxy in front of this container. Its "forwarded for"
# header is believed only from the addresses named here (addresses or CIDR
# ranges, comma-separated), because that address goes into the audit trail
# and the sign-in limits. Leave it unset without a proxy.
# TRUST_PROXY=172.16.0.0/12

# ── logs ─────────────────────────────────────────────────────────────────────
# Written to the logs volume as well as to the container's output, so
# `docker compose logs` and the files agree. Rotates at LOG_MAX_MB, keeping
# LOG_KEEP older copies.
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_MAX_MB=10
LOG_KEEP=5
