{
  "name": "@offset/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node build/copy-assets.mjs",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/db/seed.ts",
    "backup": "tsx src/db/backup.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "argon2": "^0.41.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.13",
    "pdfmake": "^0.2.10",
    "pino": "^10.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfmake": "^0.2.9",
    "@types/smtp-server": "^3.5.13",
    "pino-pretty": "^11.2.2",
    "smtp-server": "^3.19.9",
    "tsx": "^4.19.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
