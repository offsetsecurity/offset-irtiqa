{
  // The build config excludes `test` so it never lands in dist. Tests still
  // need typechecking, so this config covers both and emits nothing.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    // Nothing is emitted, so rootDir only gets in the way here.
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
